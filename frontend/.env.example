# ============================================================
# Legit HealthCare - Frontend Environment Variables
# ============================================================
# Copy this file to .env (for development) or set these as
# Environment Variables in your Render dashboard for production.
#
# All variables MUST start with VITE_ to be accessible in the
# browser bundle. Never put secrets here.
# ============================================================

# The public URL of your BACKEND (Flask) service.
# - Local development: leave empty or use http://localhost:5000
#   (the Vite dev server proxy handles /api/* automatically)
# - Render production: set to your backend web service URL
#   e.g. https://legit-healthcare-api.onrender.com
VITE_API_URL=
